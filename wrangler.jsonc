{
  "name": "dantes-sud",
  "compatibility_date": "2026-10-10",
  // Worker script: handles /api/* (contact form → Resend); everything else is static assets.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "vars": {
    "MAIL_FROM": "Site Dantès <formulaire@contact.dantes-sud.fr>",
    "MAIL_TO": "contact@dantes-sud.fr"
  }
  // Secret: RESEND_API_KEY (`bunx wrangler secret put RESEND_API_KEY`, local: .dev.vars)
}
