---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { render } from 'astro:content';
import { useTranslations, type Locale } from '../i18n';
import { pathFor, articlePath } from '../i18n/routes';
import { getArticles } from '../i18n/news';

interface Props {
	locale: Locale;
	slug: string;
	entry: Awaited<ReturnType<typeof getArticles>>[number]['entry'];
}
const { locale, slug, entry } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const hasOther = (await getArticles(other)).some((a) => a.slug === slug);
const alternates = { [locale]: articlePath(slug, locale), ...(hasOther ? { [other]: articlePath(slug, other) } : {}) };
const d = entry.data;
const fmt = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : 'en-GB', { dateStyle: 'long' });
---

<Layout locale={locale} title={`${d.title} | DANTÈS`} description={d.description} alternates={alternates} canonicalPath={articlePath(slug, locale)} ogImage={d.image}>
	<article class="wrap max-w-3xl py-14 md:py-20">
		<a href={pathFor('news', locale)} class="font-bold text-steel underline decoration-2 underline-offset-4">← {t('news.back')}</a>
		<p class="mt-8 text-sm font-semibold text-steel">
			{t(`news.types.${d.type}`)} · <time datetime={d.date.toISOString()}>{fmt.format(d.date)}</time>
		</p>
		<h1 class="display mt-2 text-4xl text-balance md:text-6xl">{d.title}</h1>
		{d.image && <img src={d.image} alt={d.imageAlt ?? ''} width="1200" height="800" class="mt-8 w-full object-cover" fetchpriority="high" />}
		<div class="prose-news mt-8 space-y-4 text-lg text-ink/85 [&_h2]:display [&_h2]:mt-10 [&_h2]:text-3xl [&_h2]:text-ink [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-bold [&_img]:my-6 [&_img]:w-full [&_a]:font-bold [&_a]:text-steel [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6">
			<Content />
		</div>
	</article>
	<CtaBand locale={locale} title={t('news.ctaTitle')} text={t('news.ctaText')} />
</Layout>
