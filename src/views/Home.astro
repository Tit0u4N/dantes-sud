---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Steps from '../components/Steps.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Vgp from '../components/Vgp.astro';
import { useTranslations, data, type Locale } from '../i18n';
import { pathFor, type PageKey } from '../i18n/routes';
import { company, social, proof, partners } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const about = data<string[]>(t, 'home.about');
const trades = data<{ key: PageKey; title: string; text: string; image: string; alt: string }[]>(t, 'home.trades');
const steps = data<{ title: string; text: string }[]>(t, 'home.steps');
const zones = data<{ code: string; name: string }[]>(t, 'home.zones');
const brands = data<string[]>(t, 'home.brands').map((name) => ({ name, logo: partners[name.toLowerCase() as keyof typeof partners]?.logo }));
---

<Layout locale={locale} pageKey="home" ogImage="/images/og/home.jpg" localBusiness title={t('meta.home.title')} description={t('meta.home.description')}>
	<section class="relative isolate overflow-hidden bg-ink text-white">
		<img src="/images/maintenance-levage-paca-chantier-marseille.webp" alt={t('home.heroAlt')} width="1500" height="2000" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]" fetchpriority="high" />
		<div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/95 via-ink/70 to-ink/20"></div>
		<div class="wrap flex min-h-[32rem] items-center py-14 md:min-h-[36rem] md:py-20">
			<div class="hex-in">
				<h1 class="max-w-[24ch] text-3xl font-bold leading-tight text-balance md:text-4xl lg:text-5xl">{t('home.h1')}</h1>
				<p class="mt-6 max-w-[60ch] text-lg text-white/90">{t('home.subtitle')}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={pathFor('contact', locale)} class="btn btn-accent">{t('ui.quote')}</a>
					<a href={company.tel} class="btn btn-ghost">{company.phone}</a>
				</div>
			</div>
		</div>
	</section>

	<section class="wrap py-14 md:py-20">
		<h2 class="display max-w-3xl text-4xl text-balance md:text-5xl">{t('home.aboutTitle')}</h2>
		<div class="mt-8 grid gap-6 md:grid-cols-3">
			{about.map((p) => <p class="text-ink/85">{p}</p>)}
		</div>
	</section>

	<section class="bg-ink-2 text-white">
		<div class="wrap py-14 md:py-20">
			<h2 class="display text-4xl md:text-5xl">{t('home.zoneTitle')}</h2>
			<p class="mt-3 max-w-[55ch] text-white/75">{t('home.zoneText')}</p>
			<ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
				{
					zones.map((z) => (
						<li class="border-t-4 border-accent pt-3">
							<span class="display block text-6xl text-white md:text-7xl">{z.code}</span>
							<span class="mt-1 block font-semibold text-white/80">{z.name}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="wrap py-14 md:py-20">
		<h2 class="display max-w-3xl text-4xl text-balance md:text-5xl">{t('home.tradesTitle')}</h2>
		<ul class="mt-14 grid gap-14 md:grid-cols-3 md:gap-8">
			{
				trades.map((s, i) => (
					<li class="group relative flex flex-col items-center text-center">
						<a href={pathFor(s.key, locale)} class="relative block w-full max-w-sm" tabindex="-1" aria-hidden="true">
							<div class="hex absolute inset-0 bg-steel transition-colors group-hover:bg-accent"></div>
							<div class="hex relative m-[7px] aspect-[1.1/1] overflow-hidden bg-sky">
								<img src={s.image} alt={s.alt} width="800" height="727" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
							</div>
							<span class="display absolute -top-3 left-2 text-6xl text-steel/25" aria-hidden="true">0{i + 1}</span>
						</a>
						<h3 class="display mt-6 text-4xl text-steel">{s.title}</h3>
						<p class="mt-3 max-w-[34ch] flex-1 text-ink/80">{s.text}</p>
						<a href={pathFor(s.key, locale)} class="btn btn-steel mt-6">
							{t('ui.moreAbout')}<span class="sr-only"> : {s.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<Vgp locale={locale} />

	<Steps title={t('home.processTitle')} steps={steps} image="/images/fourgon-dantes-grue-intervention-marseille.webp" imageAlt={t('home.processImageAlt')} />

	<section class="wrap py-14 md:py-20">
		<div class="grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-center">
			<div>
				<h2 class="display text-4xl md:text-5xl">{t('home.brandsTitle')}</h2>
				<p class="mt-3 max-w-[45ch] text-ink/75">{t('home.brandsText')}</p>
			</div>
			<ul class="grid grid-cols-2 gap-4">
				{
					brands.map((b) => (
						<li class="display border-2 border-line text-4xl text-steel">
							<a href={pathFor('partners', locale)} class="flex h-24 items-center justify-center px-6 hover:bg-paper" aria-label={b.name}>
								{b.logo ? <img src={b.logo} alt={b.name} height="56" class="max-h-14 w-auto max-w-full object-contain" loading="lazy" /> : b.name}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		(proof.clients.length > 0 || proof.googleReviewsUrl) && (
			<section class="bg-paper">
				<div class="wrap py-14">
					<h2 class="display text-4xl md:text-5xl">{t('home.proofTitle')}</h2>
					{proof.clients.length > 0 && (
						<ul class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-6">
							{proof.clients.map((c) => (
								<li><img src={c.logo} alt={c.name} height="56" class="h-14 w-auto grayscale" loading="lazy" /></li>
							))}
						</ul>
					)}
					{proof.googleReviewsUrl && (
						<a href={proof.googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block font-bold text-steel underline decoration-2 underline-offset-4">
							{t('home.reviewsLink')}
						</a>
					)}
				</div>
			</section>
		)
	}

	{
		social.instagram && (
			<section class="wrap py-14">
				<h2 class="display text-4xl md:text-5xl">{t('home.instaTitle')}</h2>
				<p class="mt-3 text-ink/75">{t('home.instaText')}</p>
				<InstagramFeed />
				<a href={social.instagram} target="_blank" rel="noopener noreferrer me" class="btn btn-steel mt-6">{t('home.instaFollow')}</a>
			</section>
		)
	}

	<CtaBand locale={locale} title={t('home.ctaTitle')} text={t('home.ctaText')} />
</Layout>
