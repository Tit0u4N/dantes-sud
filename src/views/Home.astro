---
import Layout from '../layouts/Layout.astro';
import HexPhoto from '../components/HexPhoto.astro';
import CtaBand from '../components/CtaBand.astro';
import { useTranslations, data, type Locale } from '../i18n';
import { pathFor, type PageKey } from '../i18n/routes';
import { company } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const services = data<{ key: PageKey; title: string; text: string }[]>(t, 'home.services');
const zones = data<{ code: string; name: string }[]>(t, 'home.zones');
const brands = data<{ name: string }[]>(t, 'sales.brands');
---

<Layout locale={locale} pageKey="home" title={t('meta.home.title')} description={t('meta.home.description')}>
	<section class="blueprint overflow-hidden text-white">
		<div class="wrap grid items-center gap-12 py-16 md:grid-cols-[1.15fr_1fr] md:py-24">
			<div>
				<p class="display text-3xl text-accent md:text-4xl">{t('site.tagline')}</p>
				<h1 class="mt-5 max-w-[20ch] text-3xl font-bold leading-tight text-balance md:text-4xl lg:text-5xl">
					{t('home.h1')}
				</h1>
				<p class="mt-6 max-w-[58ch] text-lg text-white/80">{t('home.intro')}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href={pathFor('contact', locale)} class="btn btn-accent">{t('ui.quote')}</a>
					<a href={company.tel} class="btn btn-ghost">{company.phone}</a>
				</div>
			</div>
			<div class="relative mx-auto h-[22rem] w-full max-w-md md:h-[28rem]" aria-hidden="false">
				<HexPhoto label={t('ui.photoTodo')} class="hex-in absolute left-0 top-0 w-[58%]" />
				<HexPhoto label={t('ui.photoTodo')} class="hex-in absolute right-0 top-[22%] w-[52%] [animation-delay:.15s]" />
				<HexPhoto label={t('ui.photoTodo')} class="hex-in absolute bottom-0 left-[18%] w-[48%] [animation-delay:.3s]" />
			</div>
		</div>
	</section>

	<section class="wrap py-16 md:py-24">
		<h2 class="display max-w-3xl text-4xl text-balance md:text-6xl">{t('home.servicesTitle')}</h2>
		<ul class="mt-12 grid gap-px bg-line md:grid-cols-3">
			{
				services.map((s) => (
					<li class="flex flex-col bg-white p-7 md:first:pl-0 md:last:pr-7">
						<h3 class="display text-3xl text-steel">{s.title}</h3>
						<p class="mt-4 flex-1 text-ink/80">{s.text}</p>
						<a href={pathFor(s.key, locale)} class="mt-6 font-bold text-steel underline decoration-2 underline-offset-4 hover:text-steel-deep">
							{t('home.more')}<span class="sr-only"> : {s.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="bg-ink-2 text-white">
		<div class="wrap py-16 md:py-20">
			<h2 class="display text-4xl md:text-5xl">{t('home.zoneTitle')}</h2>
			<p class="mt-3 max-w-[55ch] text-white/75">{t('home.zoneText')}</p>
			<ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-4">
				{
					zones.map((z) => (
						<li class="border-t-4 border-accent pt-3">
							<span class="display block text-7xl text-white md:text-8xl">{z.code}</span>
							<span class="mt-1 block font-semibold text-white/80">{z.name}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="wrap py-16 md:py-20">
		<div class="grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-center">
			<div>
				<h2 class="display text-4xl md:text-5xl">{t('home.brandsTitle')}</h2>
				<p class="mt-3 max-w-[45ch] text-ink/75">{t('home.brandsText')}</p>
			</div>
			<ul class="grid grid-cols-2 gap-4">
				{
					brands.map((b) => (
						<li class="display flex h-24 items-center justify-center border-2 border-line text-4xl text-steel">
							<a href={pathFor('sales', locale)} class="flex h-full w-full items-center justify-center hover:bg-paper">{b.name}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<CtaBand locale={locale} title={t('home.ctaTitle')} text={t('home.ctaText')} />
</Layout>
