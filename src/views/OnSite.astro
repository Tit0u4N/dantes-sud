---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import { useTranslations, data, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const assets = data<{ title: string; text: string }[]>(t, 'onsite.assets');
const steps = data<{ title: string; text: string }[]>(t, 'onsite.steps');
---

<Layout locale={locale} pageKey="onsite" title={t('meta.onsite.title')} description={t('meta.onsite.description')}>
	<PageHero title={t('onsite.h1')} lead={t('onsite.lead')} />
	<section class="wrap py-16 md:py-20">
		<h2 class="display text-4xl md:text-5xl">{t('onsite.assetsTitle')}</h2>
		<div class="mt-10 grid gap-8 md:grid-cols-3">
			{
				assets.map((a) => (
					<div class="border-l-4 border-steel pl-5">
						<h3 class="text-xl font-bold">{a.title}</h3>
						<p class="mt-2 text-ink/80">{a.text}</p>
					</div>
				))
			}
		</div>
	</section>
	<Steps title={t('onsite.processTitle')} steps={steps} />
	<CtaBand locale={locale} title={t('onsite.ctaTitle')} text={t('onsite.ctaText')} />
</Layout>
