---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import HexPhoto from '../components/HexPhoto.astro';
import { useTranslations, data, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const possible = data<string[]>(t, 'workshop.possible');
const steps = data<{ title: string; text: string }[]>(t, 'workshop.steps');
---

<Layout locale={locale} pageKey="workshop" title={t('meta.workshop.title')} description={t('meta.workshop.description')}>
	<PageHero title={t('workshop.h1')} lead={t('workshop.lead')} />
	<section class="wrap grid items-center gap-12 py-16 md:grid-cols-[1.2fr_1fr] md:py-20">
		<div>
			<h2 class="display text-4xl md:text-5xl">{t('workshop.possibleTitle')}</h2>
			<ul class="mt-8 space-y-3">
				{
					possible.map((p) => (
						<li class="flex gap-3">
							<span class="hex mt-1.5 h-4 w-4 shrink-0 bg-steel" aria-hidden="true" />
							<span class="font-semibold">{p}</span>
						</li>
					))
				}
			</ul>
			<p class="mt-6 max-w-[55ch] text-ink/80">{t('workshop.possibleText')}</p>
		</div>
		<HexPhoto label={t('ui.photoTodo')} class="mx-auto w-full max-w-sm" />
	</section>
	<Steps title={t('workshop.processTitle')} steps={steps} />
	<CtaBand locale={locale} title={t('workshop.ctaTitle')} text={t('workshop.ctaText')} />
</Layout>
