---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { useTranslations, data, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const brands = data<{ name: string; title: string; text: string }[]>(t, 'sales.brands');
---

<Layout locale={locale} pageKey="sales" title={t('meta.sales.title')} description={t('meta.sales.description')}>
	<PageHero title={t('sales.h1')} lead={t('sales.lead')} />
	<section class="wrap py-16 md:py-20">
		<ul class="divide-y divide-line border-y border-line">
			{
				brands.map((b) => (
					<li class="grid gap-4 py-8 md:grid-cols-[14rem_1fr] md:gap-10">
						<h2 class="display text-5xl text-steel">{b.name}</h2>
						<div>
							<h3 class="text-xl font-bold">{b.title}</h3>
							<p class="mt-2 max-w-[60ch] text-ink/80">{b.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>
	<CtaBand locale={locale} title={t('sales.ctaTitle')} text={t('sales.ctaText')} />
</Layout>
