---
import Socials from './Socials.astro';
import { useTranslations, type Locale } from '../i18n';
import { pathFor, menuKeys, type PageKey } from '../i18n/routes';
import { company } from '../config';

interface Props {
	locale: Locale;
	pageKey?: PageKey;
	/** Language switch target when the page has no PageKey (articles). */
	altHref?: string;
}
const { locale, pageKey, altHref } = Astro.props;
const t = useTranslations(locale);
const other: Locale = locale === 'fr' ? 'en' : 'fr';
const langHref = altHref ?? (pageKey ? pathFor(pageKey, other) : pathFor('home', other));
const current = pageKey === 'thanks' ? undefined : pageKey ?? 'news';

const items = menuKeys.map((k) => ({ href: pathFor(k, locale), label: t(`nav.${k}`), current: current === k }));
const link = 'px-2.5 py-2 font-semibold hover:text-steel aria-[current=page]:text-steel aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8';
---

<a
	href="#main"
	class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2"
	>{t('ui.skip')}</a
>
<div class="bg-ink text-white">
	<div class="wrap flex h-10 items-center justify-between gap-4 text-sm">
		<a href={company.tel} class="font-bold hover:text-accent">
			<span class="sr-only">{t('ui.call')} </span>
			<svg class="mr-1.5 inline -translate-y-px" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z" /></svg>{company.phone}
		</a>
		<div class="flex items-center gap-4">
			<Socials locale={locale} />
			<a href={langHref} hreflang={other} lang={other} title={t('ui.langSwitch')} class="font-semibold hover:text-accent">{t('ui.langCode')}</a>
		</div>
	</div>
</div>
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
	<div class="wrap flex h-[4.25rem] items-center justify-between gap-3">
		<a href={pathFor('home', locale)} class="shrink-0" aria-label={t('site.title')}>
			<img src="/images/logo-dantes.webp" alt={t('site.logoAlt')} width="1000" height="250" class="h-9 w-auto sm:h-10" />
		</a>

		<nav aria-label={t('ui.mainNav')} class="hidden items-center lg:flex">
			{items.map((i) => <a href={i.href} class={link} aria-current={i.current ? 'page' : undefined}>{i.label}</a>)}
		</nav>

		<div class="flex items-center gap-2">
			<a href={pathFor('contact', locale)} class="btn btn-steel !px-3.5 !py-2 text-sm sm:!px-5 sm:!py-2.5 sm:text-base">{t('ui.quote')}</a>
			<details class="group relative lg:hidden">
				<summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border-2 border-steel text-steel [&::-webkit-details-marker]:hidden" aria-label={t('ui.menu')}>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
						<path class="group-open:hidden" d="M4 6h16M4 12h16M4 18h16" />
						<path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
					</svg>
				</summary>
				<div class="absolute right-0 top-full mt-3 w-72 border border-line bg-white p-3 shadow-xl">
					<ul class="flex flex-col">
						{items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined} class="block px-3 py-3 font-semibold aria-[current=page]:text-steel">{i.label}</a></li>)}
					</ul>
				</div>
			</details>
		</div>
	</div>
</header>
