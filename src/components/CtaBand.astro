---
import { useTranslations, type Locale } from '../i18n';
import { pathFor } from '../i18n/routes';
import { company } from '../config';

interface Props {
	locale: Locale;
	title: string;
	text: string;
}
const { locale, title, text } = Astro.props;
const t = useTranslations(locale);
---

<section class="bg-steel text-white">
	<div class="wrap flex flex-col items-start justify-between gap-8 py-14 md:flex-row md:items-center">
		<div class="max-w-[52ch]">
			<h2 class="display text-4xl md:text-5xl">{title}</h2>
			<p class="mt-3 text-lg text-white/90">{text}</p>
		</div>
		<div class="flex flex-wrap gap-3">
			<a href={pathFor('contact', locale)} class="btn btn-light">{t('ui.quote')}</a>
			<a href={company.tel} class="btn btn-ghost">{company.phone}</a>
		</div>
	</div>
</section>
