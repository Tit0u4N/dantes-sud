---
// Static photo grid of the Instagram posts listed in config (images stored locally, no third-party script).
import { social } from '../config';

const posts = social.instagramPosts;
const icon = 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z';
---

{
	posts.length > 0 && (
		<ul class="mt-8 grid grid-cols-3 gap-2 md:gap-4">
			{posts.map((p) => (
				<li>
					<a href={p.url} target="_blank" rel="noopener noreferrer" class="group relative block aspect-[4/5] overflow-hidden bg-sky">
						<img src={p.image} alt={p.alt} width="810" height="1080" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
						<span class="absolute inset-0 flex flex-col justify-end gap-2 bg-gradient-to-t from-ink/85 via-ink/20 to-transparent p-2 text-xs md:p-4 md:text-sm font-semibold text-white transition-opacity duration-300 md:opacity-0 md:group-hover:opacity-100 group-focus-visible:opacity-100">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icon} /></svg>
							<span class="line-clamp-3 md:line-clamp-none">{p.alt}</span>
						</span>
						<span class="absolute inset-x-0 bottom-0 h-1 origin-left bg-accent transition-transform duration-300 md:scale-x-0 md:group-hover:scale-x-100"></span>
					</a>
				</li>
			))}
		</ul>
	)
}
