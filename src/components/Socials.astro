---
// LinkedIn / Instagram / Google Business Profile icons. Each one only shows once its URL is set in config.
import { useTranslations, type Locale } from '../i18n';
import { social } from '../config';

interface Props {
	locale: Locale;
	class?: string;
}
const { locale, class: cls = '' } = Astro.props;
const t = useTranslations(locale);
const items = [
	{
		url: social.linkedin,
		label: t('social.linkedin'),
		path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.5 0h3.83v1.57h.05c.53-1 1.84-2.07 3.78-2.07 4.04 0 4.79 2.66 4.79 6.12v5.88h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4V9.75Z',
	},
	{
		url: social.instagram,
		label: t('social.instagram'),
		path: 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
	},
	{
		url: social.gbp,
		label: t('social.gbp'),
		path: 'M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7Zm0 4a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
	},
].filter((i) => i.url);
---

{
	items.length > 0 && (
		<ul class={`flex items-center gap-3 ${cls}`}>
			{items.map((i) => (
				<li>
					<a href={i.url} target="_blank" rel="noopener noreferrer me" aria-label={i.label} title={i.label} class="block p-1 hover:text-accent">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d={i.path} />
						</svg>
					</a>
				</li>
			))}
		</ul>
	)
}
