---
import Home from '../views/Home.astro';
import Trade from '../views/Trade.astro';
import Partners from '../views/Partners.astro';
import News from '../views/News.astro';
import Contact from '../views/Contact.astro';
import Thanks from '../views/Thanks.astro';
import { locales } from '../i18n';
import { pageKeys, routeParam } from '../i18n/routes';

export function getStaticPaths() {
	return pageKeys.flatMap((key) =>
		locales.map((locale) => ({ params: { path: routeParam(key, locale) }, props: { key, locale } })),
	);
}

const { key, locale } = Astro.props;
---

{key === 'home' && <Home locale={locale} />}
{(key === 'lifting' || key === 'elevation' || key === 'handling') && <Trade locale={locale} kind={key} />}
{key === 'partners' && <Partners locale={locale} />}
{key === 'news' && <News locale={locale} />}
{key === 'contact' && <Contact locale={locale} />}
{key === 'thanks' && <Thanks locale={locale} />}
